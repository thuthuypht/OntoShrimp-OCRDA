    <rdfs:comment>Species provenance classification for P. vannamei cases.</rdfs:comment>
    <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    <sd:ruleLayer>SWRL</sd:ruleLayer>
    <sd:implementationStatus>active</sd:implementationStatus>
